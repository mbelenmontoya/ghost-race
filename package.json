{
  "name": "ghost-race",
  "productName": "Ghost Race",
  "version": "1.0.0",
  "upgrade": "pear://c85q5x645jc8kxxgfdrpirfn8mmzpmaadczidxiqogtdqnek6ojy",
  "description": "A shared mountain where friends drop their ski runs and climb a podium by kilometres",
  "license": "UNLICENSED",
  "author": "Belén Montoya",
  "type": "commonjs",
  "main": "electron/main.js",
  "private": true,
  "scripts": {
    "lint": "prettier --check . && lunte",
    "format": "prettier --write . && lunte --fix",
    "dev": "concurrently -k -n vite,app \"npm --prefix frontend run dev\" \"wait-on http://127.0.0.1:5173 && cross-env PEAR_DEV_SERVER_URL=http://127.0.0.1:5173 electron-forge start -- --no-updates\"",
    "start": "npm run build:frontend && electron-forge start -- --no-updates",
    "build:frontend": "npm --prefix frontend run build",
    "postinstall": "npm run install:frontend",
    "install:frontend": "npm --prefix frontend install",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "make:mas": "electron-forge make --platform=mas",
    "install:all": "npm i --ignore-scripts=true && npm run postinstall:all",
    "install:mac": "npm i --ignore-scripts=true && npm run postinstall:mac",
    "postinstall:all": "npm run install:electron && npm run install:frontend",
    "postinstall:mac": "npm run postinstall:all && npm run install:macos-alias && npm run install:fs-xattr",
    "install:electron": "node node_modules/electron/install.js",
    "install:macos-alias": "cd node_modules/macos-alias && node-gyp rebuild",
    "install:fs-xattr": "cd node_modules/fs-xattr && node-gyp rebuild",
    "test": "brittle test/*.test.js && npm --prefix frontend test"
  },
  "dependencies": {
    "autopass": "^3.4.1",
    "bare-fs": "^4.8.4",
    "bare-path": "^3.1.2",
    "bare-process": "^4.5.1",
    "bare-storage": "^1.1.0",
    "blind-pairing-core": "^2.10.1",
    "corestore": "^7.15.0",
    "framed-stream": "^1.0.1",
    "graceful-goodbye": "^1.3.3",
    "hyperswarm": "^4.17.2",
    "paparam": "^1.10.0",
    "pear-mobile": "^4.3.0",
    "pear-runtime": "^1.3.1",
    "which-runtime": "^1.4.0",
    "z32": "^1.1.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.1",
    "@electron-forge/maker-deb": "^7.11.1",
    "@electron-forge/maker-dmg": "^7.11.1",
    "@electron-forge/maker-msix": "^7.11.1",
    "@electron-forge/maker-pkg": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.11.1",
    "@electron-forge/maker-zip": "^7.11.1",
    "@electron/node-gyp": "git+ssh://git@github.com/electron/node-gyp.git#06b29aafb7708acef8b3669835c8a7857ebc92d2",
    "app-builder-lib": "^26.8.1",
    "brittle": "^3.19.1",
    "concurrently": "^9.2.5",
    "cross-env": "^10.1.0",
    "electron": "^42.0.1",
    "electron-forge-plugin-prune-prebuilds": "^1.0.2",
    "electron-forge-plugin-universal-prebuilds": "^1.0.0",
    "lunte": "^1.6.0",
    "pear-electron-forge-maker-appimage": "^2.0.0",
    "prettier": "^3.8.1",
    "prettier-config-holepunch": "^2.0.0",
    "wait-on": "^9.5.1"
  },
  "allowScripts": {
    "electron@40.10.1": true,
    "electron-winstaller": false
  },
  "imports": {
    "pear-runtime": {
      "ios": "pear-mobile",
      "android": "pear-mobile",
      "simulator": "pear-mobile",
      "default": "pear-runtime"
    }
  }
}
